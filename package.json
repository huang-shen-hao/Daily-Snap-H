{
  "name": "uni-preset-vue",
  "version": "0.0.0",
  "scripts": {
    "prod": "yarn dev_prod:mp-weixin",
    "dev": "yarn dev:mp-weixin",
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin -m dev",
    "dev_prod:mp-weixin": "uni -p mp-weixin -m prod",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "type-check": "vue-tsc --noEmit",
    "lint": "eslint . --ext \"./**/*.{vue,js,ts,jsx,tsx,mjs,cjs}\" --fix",
    "lint:prettier": "prettier \"./**/*.{vue,js,ts,jsx,tsx,mjs,cjs,html,json,md}\" --write",
    "lint:stylelint": "stylelint \"./**/*.{vue,css,scss,html}\" --fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-3090920231225001",
    "@dcloudio/uni-components": "3.0.0-3090920231225001",
    "@dcloudio/uni-mp-weixin": "3.0.0-3090920231225001",
    "@tsconfig/node18": "2.0.1",
    "pinia": "2.0.22",
    "pinia-plugin-persistedstate": "3.2.1",
    "postcss-html": "^1.8.0",
    "sass": "^1.86.3",
    "typescript": "5.0.4",
    "uni-pages-hot-modules": "^1.0.3",
    "vue": "^3.2.45",
    "vue-eslint-parser": "^10.1.3",
    "vue-i18n": "^9.1.9",
    "vue-tsc": "1.4.4"
  },
  "devDependencies": {
    "@dcloudio/types": "^3.3.2",
    "@dcloudio/uni-automator": "3.0.0-3090920231225001",
    "@dcloudio/uni-cli-shared": "3.0.0-3090920231225001",
    "@dcloudio/uni-stacktracey": "3.0.0-3090920231225001",
    "@dcloudio/vite-plugin-uni": "3.0.0-3090920231225001",
    "@eslint/js": "^9.23.0",
    "@types/node": "^18.19.86",
    "@vue/runtime-core": "^3.2.45",
    "eslint": "^9.23.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-import-resolver-typescript": "^4.2.2",
    "eslint-plugin-prettier": "^5.2.4",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.0",
    "prettier": "3.5.3",
    "sass-embedded": "^1.86.0",
    "stylelint": "^16.16.0",
    "stylelint-config-standard": "^37.0.0",
    "stylelint-config-standard-scss": "^14.0.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript-eslint": "^8.27.0",
    "vite": "4.0.3",
    "vite-plugin-cdn-import": "^1.0.1"
  },
  "lint-staged": {
    "**/*.{vue,js,ts,jsx,tsx,mjs,cjs,html,json,md}": [
      "prettier --write"
    ],
    "**/*.{vue,js,ts,jsx,tsx,mjs,cjs}": [
      "eslint --cache --fix"
    ],
    "**/*.{vue,css,scss,html}": [
      "stylelint --fix"
    ]
  }
}

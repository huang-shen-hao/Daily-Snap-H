{
"pages": /* #exec hotJs('./router/routerPages.ts') */,
"easycom": {
		"autoscan": true,
		"custom": {
			"^uni-(.*)": "@dcloudio/uni-ui/lib/uni-$1/uni-$1.vue"
		}
	},
"globalStyle": {
  "navigationBarTextStyle": "black",
  "navigationBarTitleText": "uni-app",
  "navigationBarBackgroundColor": "#F8F8F8",
  "backgroundColor": "#F8F8F8"
  },
  "tabBar": {
    "color": "#7A7E83",
    "selectedColor": "#3cc51f",
    "borderStyle": "black",
    "backgroundColor": "#ffffff",
    "list": [{
      "pagePath": "pages/home/home",
      "iconPath": "static/image/home_before.png",
      "selectedIconPath": "static/image/home_after.png",
      "text": "首页"
    }, {
      "pagePath": "pages/center/center",
      "iconPath": "static/image/center_before.png",
      "selectedIconPath": "static/image/center_after.png",
      "text": "中心"
    },
    {
      "pagePath": "pages/my/my",
      "iconPath": "static/image/my_before.png",
      "selectedIconPath": "static/image/my_after.png",
      "text": "我的"
    }]
  }
}
